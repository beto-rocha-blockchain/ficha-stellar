# ---------------------------------------------------------------------------
# Ficha: the HackMeridian demo station YX3DGE (Lisbon, testnet), custody mode.
#   copy .env.lisbon.example .env        (Linux: cp .env.lisbon.example .env)
#
# Simulated relay and phone, REAL testnet deposits: the Ficha app pays the
# FichaEscrow contract and the station watches it, read only. Runs on any
# laptop with internet and no hardware: for rehearsals, and the fallback if
# the relay or the phone fails at the table. On the real relay use
# .env.mains.example (wall charger, phone over WiFi ADB) or
# .env.usbvbus.example (phone on the laptop's USB) instead.
#
# At the table, E on the station screen ends a session early: its unused
# time comes back with the receipt (the refund moment of the demo, without
# waiting for a pause to time out). ESC is only the emergency power cut. U
# unplugs the simulated phone and plugs it back in (MOCK=true only). After
# the FINISHED screen, a receipt waiting on the waiting screen is a ficha:
# link: the Ficha app's Scan QR opens it, the phone's camera does not.
#
# No secret here, ever: the station holds no Stellar key. Every setting left
# out takes its default; .env.example documents them all.
# ---------------------------------------------------------------------------

# --- modes -----------------------------------------------------------------
MOCK=true
# Real deposits only: no POST /debug/pay.
MOCK_PAYMENT=false
# Where the simulated phone is plugged in: station (charges while the relay
# is closed), elsewhere (another charger: probes fail), none.
MOCK_PLUG=station

# --- server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- this station (its signed registry entry) --------------------------------
STATION_ID=YX3DGE
STATION_NAME='HackMeridian demo (testnet)'
# Receipts and pay links open the Ficha site, or the Android app.
APP_URL=https://ficha-stellar.vercel.app
# Refuses to start if this file and the registry entry or the contract's
# terms differ (README, sections 5 and 7). While running it reads both again
# every minute and goes out of service on a difference: to change either,
# stop the station, publish the registry, update this file, then start it.
REGISTRY_CHECK=true

# --- stellar ---------------------------------------------------------------
STELLAR_NETWORK=testnet
# The demo host's PUBLIC key: the contract pays the host's share here (a
# release at once; a claim's share is held for it until pay_host, which the
# host's phone sends with host mode's Collect button).
HOST_PUBLIC_KEY=GCJC2PFILBFQCYFBIDEQG3RZFNOA2ID7ULAEZJUZ5ULZX6BM3ME3XTN6
# Empty = native XLM, the only asset custody takes.
PAYMENT_ASSET_CODE=
PAYMENT_ASSET_ISSUER=
HORIZON_POLL_SECONDS=2
CURSOR_DIR=.
SESSION_LOG=sessions.jsonl

# --- custody (README, section 7) ---------------------------------------------
PAYMENT_MODE=custody
ESCROW_CONTRACT=CBRNN2W726PIWP7DLLCAOW663I2TBSMR6N7J7S4CGGUIWIXK4HYI6KYC
# Empty = https://soroban-testnet.stellar.org
RPC_URL=
# YX3DGE's terms on the contract: refunds in 15 s units (40 in a full
# session), deadline 28 min after the paid time.
REFUND_UNIT_SECONDS=15
ESCROW_GRACE_SECONDS=1680

# --- product (must equal the registry entry) -----------------------------------
# 1 XLM per 1-minute ficha, up to 10 in a session.
FICHA_PRICE=1
FICHA_MINUTES=1
MAX_SESSION_MINUTES=10
FINISHED_SECONDS=60

# --- charge verification (custody requires it) --------------------------------
CHARGE_VERIFY=true
METER_SOURCE=phone

# --- topology (simulated) ------------------------------------------------------
TOPOLOGY=mains
