# ---------------------------------------------------------------------------
# Ficha: the HackMeridian demo station YX3DGE on the real relay, with a WALL
# CHARGER and the phone read over WiFi ADB (custody mode, testnet).
#   copy .env.mains.example .env         (Linux: cp .env.mains.example .env)
#
# Wiring: USB wall charger -> USB cable with its red VBUS wire cut through the
# relay's COM and NO (never NC) -> phone. 5 V only: no switched 230 V at the
# table. The cable carries no data to the laptop, so the phone is read over
# WiFi ADB: laptop and phone on the same network, one that lets them reach
# each other (a travel router; a venue WiFi that isolates clients does not).
# A VPN that blocks the local network (README) must be off.
#
# Once per phone, over USB: adb tcpip 5555, then unplug and fill ADB_SERIAL
# with the phone's WiFi address. Check with: python diag.py meter
# Plan B when WiFi ADB cannot work: .env.usbvbus.example.
#
# No secret here, ever: the station holds no Stellar key. Every setting left
# out takes its default; .env.example documents them all.
# ---------------------------------------------------------------------------

# --- modes -----------------------------------------------------------------
MOCK=false
MOCK_PAYMENT=false

# --- server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- this station (its signed registry entry) --------------------------------
STATION_ID=YX3DGE
STATION_NAME='HackMeridian demo (testnet)'
APP_URL=https://ficha-stellar.vercel.app
# Refuses to start on a difference from the registry or the contract, and
# re-reads both every minute (README, sections 5 and 7).
REGISTRY_CHECK=true

# --- stellar ---------------------------------------------------------------
STELLAR_NETWORK=testnet
HOST_PUBLIC_KEY=GCJC2PFILBFQCYFBIDEQG3RZFNOA2ID7ULAEZJUZ5ULZX6BM3ME3XTN6
# Empty = native XLM, the only asset custody takes.
PAYMENT_ASSET_CODE=
PAYMENT_ASSET_ISSUER=
HORIZON_POLL_SECONDS=2
CURSOR_DIR=.
SESSION_LOG=sessions.jsonl

# --- custody (README, section 7) ---------------------------------------------
PAYMENT_MODE=custody
ESCROW_CONTRACT=CBRNN2W726PIWP7DLLCAOW663I2TBSMR6N7J7S4CGGUIWIXK4HYI6KYC
RPC_URL=
REFUND_UNIT_SECONDS=15
ESCROW_GRACE_SECONDS=1680

# --- product (must equal the registry entry) -----------------------------------
FICHA_PRICE=1
FICHA_MINUTES=1
MAX_SESSION_MINUTES=10
FINISHED_SECONDS=60

# --- charge verification (custody requires it) --------------------------------
CHARGE_VERIFY=true
METER_SOURCE=phone

# --- relay (LCUS V4.3, CH340, 9600 8N1) ----------------------------------------
# The board's COM port (Device Manager, "USB-SERIAL CH340").
RELAY_PORT=COM3

# --- topology: wall charger, phone over WiFi ADB ---------------------------------
# A cut cable read over WiFi stays readable with the power off: that is
# TOPOLOGY=mains, whatever the relay switches (README, section 2).
TOPOLOGY=mains
ADB_TRANSPORT=tcp
# The phone's WiFi address and port, e.g. 192.168.8.20:5555.
ADB_SERIAL=
ADB_PATH=adb
METER_CURRENT_SCALE=auto
