# ---------------------------------------------------------------------------
# Ficha: the HackMeridian demo station YX3DGE on the real relay, with the
# phone on the LAPTOP'S USB through the cut cable (custody mode, testnet).
#   copy .env.usbvbus.example .env       (Linux: cp .env.usbvbus.example .env)
#
# The plan B when WiFi ADB cannot work (a venue WiFi that isolates clients):
# the phone is read over USB through the same cable, so the meter needs no
# network between laptop and phone; the station still needs internet for the
# contract (any WiFi, or a phone's hotspot).
#
# Wiring: laptop USB 3.0 port -> USB extension with its red VBUS wire cut
# through the relay's COM and NO (never NC) -> phone. Ground and data stay
# intact. ADB drops when the relay opens and comes back when it closes: that
# is how the probes and the final cut are seen (README, section 2). The
# laptop port gives 450-600 mA, so the phone charges slowly.
#
# Check with: python diag.py meter   (USB debugging on, this laptop allowed)
#
# No secret here, ever: the station holds no Stellar key. Every setting left
# out takes its default; .env.example documents them all.
# ---------------------------------------------------------------------------

# --- modes -----------------------------------------------------------------
MOCK=false
MOCK_PAYMENT=false

# --- server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- this station (its signed registry entry) --------------------------------
STATION_ID=YX3DGE
STATION_NAME='HackMeridian demo (testnet)'
APP_URL=https://ficha-stellar.vercel.app
# Refuses to start on a difference from the registry or the contract, and
# re-reads both every minute (README, sections 5 and 7).
REGISTRY_CHECK=true

# --- stellar ---------------------------------------------------------------
STELLAR_NETWORK=testnet
HOST_PUBLIC_KEY=GCJC2PFILBFQCYFBIDEQG3RZFNOA2ID7ULAEZJUZ5ULZX6BM3ME3XTN6
# Empty = native XLM, the only asset custody takes.
PAYMENT_ASSET_CODE=
PAYMENT_ASSET_ISSUER=
HORIZON_POLL_SECONDS=2
CURSOR_DIR=.
SESSION_LOG=sessions.jsonl

# --- custody (README, section 7) ---------------------------------------------
PAYMENT_MODE=custody
ESCROW_CONTRACT=CBRNN2W726PIWP7DLLCAOW663I2TBSMR6N7J7S4CGGUIWIXK4HYI6KYC
RPC_URL=
REFUND_UNIT_SECONDS=15
ESCROW_GRACE_SECONDS=1680

# --- product (must equal the registry entry) -----------------------------------
FICHA_PRICE=1
FICHA_MINUTES=1
MAX_SESSION_MINUTES=10
FINISHED_SECONDS=60

# --- charge verification (custody requires it) --------------------------------
CHARGE_VERIFY=true
METER_SOURCE=phone

# --- free emergency minutes (docs/free-minutes.md) -------------------------------
# Once a day, every phone gets 2 min of charging and 2 min of internet, free,
# through the station's Wi-Fi portal; the emergency numbers on the portal and
# on the screen. simulate = no router (open http://127.0.0.1:8000/portal on
# this computer; the free internet is recorded, not given). .env.example
# documents every setting.
WIFI_PORTAL=simulate
FREE_CHARGE_SECONDS=120
FREE_INTERNET_SECONDS=120
FREE_RESET=midnight
# Lisbon (the whole EU): 112. Brazil: 'Polícia 190; SAMU 192; Bombeiros 193'
EMERGENCY_NUMBERS='Emergency 112'
# With the GL.iNet router running openNDS (openwrt/), instead of simulate:
# WIFI_PORTAL=opennds
# HOST=0.0.0.0
# WIFI_SSID='Ficha SOS'
# WIFI_SECURITY=nopass

# --- relay (LCUS V4.3, CH340, 9600 8N1) ----------------------------------------
# The board's COM port (Device Manager, "USB-SERIAL CH340").
RELAY_PORT=COM3

# --- topology: phone on the laptop's USB -----------------------------------------
TOPOLOGY=usb_vbus
ADB_TRANSPORT=usb
# Optional: the phone's serial from `adb devices`, when more than one is attached.
ADB_SERIAL=
ADB_PATH=adb
METER_CURRENT_SCALE=auto
