{
  "rewrites": [
    { "source": "/((?!registry|\\.well-known|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/registry/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
