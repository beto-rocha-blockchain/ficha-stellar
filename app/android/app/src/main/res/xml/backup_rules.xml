<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older (API 30 and below). Keys stay on this phone only, so
  no app data goes to any backup. allowBackup="false" already turns backup
  off there; this list is a second guard. See data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
