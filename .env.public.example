# ---------------------------------------------------------------------------
# Ficha: a DIRECT-mode station on the PUBLIC network (mainnet): REAL money.
# Applied on top of this computer's .env, which keeps the hardware (TOPOLOGY,
# RELAY_PORT, ADB_SERIAL), from the repo root:
#   .venv\Scripts\dotenv -f .env.public.example run .venv\Scripts\python main.py
#   (Linux: .venv/bin/dotenv -f .env.public.example run .venv/bin/python main.py)
#
# Payers pay the SEP-7 QR from any Stellar wallet, straight to the host's
# account, with the session's memo; the station only reads Horizon. Direct
# mode only: custody is testnet only. The station starts only when this file
# matches its entry in the signed registry/stations.public.json, checked with
# the pinned public registry key (docs/operators.md, section 4).
#
# Replace every <...> and G... with this station's own values: STATION_ID,
# HOST_PUBLIC_KEY, the asset and the product must equal its signed entry.
#
# No secret here, ever: the station holds no Stellar key, and the registry's
# secret never leaves the operator's machine. A setting left out is filled
# from .env (config.py never overrides a variable already set), so every
# setting that touches money is here, even at its default; .env.example
# documents them all.
# ---------------------------------------------------------------------------

# --- modes -----------------------------------------------------------------
# Both refused on the public network: a real relay and phone, real payments.
MOCK=false
MOCK_PAYMENT=false

# --- server ----------------------------------------------------------------
HOST=127.0.0.1

# --- this station (its signed registry entry) --------------------------------
STATION_ID=<ID>
# Shown on the screen and in the wallet's payment message; empty = none.
STATION_NAME=
APP_URL=https://ficha-stellar.vercel.app
# Refuses to start unless this file matches its entry, and re-reads the
# site's copy every minute (out of service on a difference). Required on
# public.
REGISTRY_CHECK=true
# Empty = the site's registry/stations.public.json, then the repo's copy.
REGISTRY_URL=
REGISTRY_FILE=
# Empty = the pinned public registry key; any other key is refused on public.
# NEVER the registry secret (starts with S).
REGISTRY_KEY=

# --- stellar ---------------------------------------------------------------
STELLAR_NETWORK=public
# Empty = https://horizon.stellar.org. Another one must be https and say it
# serves the public network.
HORIZON_URL=
# The host's MAINNET public key: payments go straight to it. Never a secret,
# never the testnet demo's key (refused).
HOST_PUBLIC_KEY=G...
# XLM with no issuer = native XLM. For USDC: PAYMENT_ASSET_CODE=USDC and its
# issuer, confirmed on stellar.expert; the host needs a trustline to it.
PAYMENT_ASSET_CODE=XLM
PAYMENT_ASSET_ISSUER=
PAYMENT_MODE=direct
# Its own log and cursor, apart from any testnet station's: a folder outside
# the repo, made first (the log is what the host refunds from, by hand).
SESSION_LOG=<folder>/sessions.jsonl
CURSOR_DIR=<folder>

# --- product (must equal the registry entry) -----------------------------------
FICHA_PRICE=<price>
FICHA_MINUTES=<minutes>
MAX_SESSION_MINUTES=<minutes>
# The C key's free charge: off with real money.
COURTESY_SECONDS=0

# --- charge verification (required on public) --------------------------------
# Paid time counts only while this station charges the phone.
CHARGE_VERIFY=true
METER_SOURCE=phone

# --- free emergency minutes: off ---------------------------------------------
WIFI_PORTAL=off
FREE_CHARGE_SECONDS=0
FREE_INTERNET_SECONDS=0
