# ---------------------------------------------------------------------------
# Ficha station configuration. Copy to .env and edit.
# As shipped, everything is simulated: no relay board, no phone, fake payments.
# ---------------------------------------------------------------------------

# --- modes -----------------------------------------------------------------
# MOCK=true swaps in MockRelay and MockMeter.
MOCK=true
# MOCK_PAYMENT=true enables POST /debug/pay. Refused on the public network.
MOCK_PAYMENT=true
# Numbers the fake meter produces: fast (mains charger) or usb (laptop port).
# Empty follows TOPOLOGY.
MOCK_PROFILE=
# Where the fake phone is plugged in, to try charge verification by hand:
# station (charges only while the relay is closed), elsewhere (another
# charger, e.g. a socket at home: charges whatever the relay does), none.
# Empty = station.
MOCK_PLUG=

# --- server ----------------------------------------------------------------
# Must be a loopback address (127.0.0.1, localhost) while MOCK_PAYMENT is on,
# or anyone on the network could make free payments: the station refuses.
HOST=127.0.0.1
PORT=8000

# --- this station ----------------------------------------------------------
# 6 characters from 23456789ABCDEFGHJKMNPQRSTVWXYZ (no 0 1 I L O U), printed
# on the hardware and listed in the signed registry (tools/registry.py new-id).
# Payment memos become <STATION_ID>.<SESSION>, so several stations can share
# one host key. Empty = legacy: the memo is the bare session ID.
STATION_ID=
# Shown on the screen and in the wallet's payment message. Up to 64 characters.
STATION_NAME=
# The Ficha app's https address, for the receipt QR on the FINISHED screen.
# Empty = receipts start with ficha:/r?v=1... (the app reads both). Suggested:
#   APP_URL=https://ficha-stellar.vercel.app
# so a receipt scanned with the phone's camera opens the site, or the Ficha
# app where it is installed.
APP_URL=

# --- signed registry check ---------------------------------------------------
# With STATION_ID set, the station checks at startup that its entry in the
# signed registry (what the app shows and charges) matches this file:
# STELLAR_NETWORK, HOST_PUBLIC_KEY, the asset, FICHA_PRICE, FICHA_MINUTES,
# MAX_SESSION_MINUTES, PAYMENT_MODE (and in custody mode ESCROW_CONTRACT,
# REFUND_UNIT_SECONDS, ESCROW_GRACE_SECONDS), and that it is active. Any difference, or a registry
# whose signature does not verify, refuses to start and lists what differs.
# Only the registry's PUBLIC key is needed. With no copy readable it starts
# anyway (offline) and the footer says "registry unchecked". A custody
# station reads it again every minute while it runs, and goes out of service
# (no pay QR) on a difference until restarted with matching values.
# false = skip the check (development only).
REGISTRY_CHECK=true
# Tried first, with a short timeout. Empty = the copy published with the site:
# https://ficha-stellar.vercel.app/registry/stations.json
# (stations.public.json on public).
REGISTRY_URL=
# Used when the site cannot be reached. Empty = registry/stations.json in this
# repo (registry/stations.public.json on public); the .sig sits next to it.
REGISTRY_FILE=
# The registry public key the app pins (G..., docs/station-app-contract.md).
# Empty = the pinned testnet key; none is pinned for public yet. NEVER the
# registry secret (starts with S): the station refuses it.
REGISTRY_KEY=

# --- offered network (optional) --------------------------------------------
# A WiFi the user can join to pay when they have no mobile data. The station
# does not create or manage it (a router or the OS hotspot does); it only
# shows a "Get online" QR next to the payment QR. Empty WIFI_SSID = no QR.
# WIFI_SECURITY: WPA (WPA/WPA2, password 8 to 63 characters) or nopass.
# Empty = WPA. See docs/operators.md, section 3: no client isolation, and no
# captive portal other than this station's own (WIFI_PORTAL, below).
# Quote values with # $ or spaces in single quotes, e.g. WIFI_PASSWORD='caf#$ 2024',
# or .env parsing changes them and the QR carries the wrong password.
WIFI_SSID=
WIFI_PASSWORD=
WIFI_SECURITY=

# --- free emergency minutes and the Wi-Fi portal (docs/free-minutes.md) ------
# For places where people may need to call or message for help: once a day,
# every phone gets FREE_CHARGE_SECONDS of charging (this station's relay) and
# FREE_INTERNET_SECONDS of internet (the station's Wi-Fi router), free. No
# money moves. Paying with Ficha works on that Wi-Fi at any time without
# spending them (the router lets the Ficha site and Stellar through).
# WIFI_PORTAL:
#   off (or empty): no portal, no free minutes: the station as before.
#   opennds: the station's OpenWrt router runs openNDS and sends each phone
#     that joins to http://<this computer>:PORT/portal (FAS level 0); the
#     router gives and limits the free internet. Needs HOST=0.0.0.0 (or this
#     computer's address on the router's network), WIFI_SSID, and
#     MOCK_PAYMENT=false. The station screen, its keys and /debug then answer
#     only to this computer; a phone that opens the station's address gets
#     the portal.
#   simulate: no router, a demo on this computer: open
#     http://127.0.0.1:PORT/portal; the free internet is recorded, not given.
# A phone is its Wi-Fi MAC address, kept only as a salted hash whose salt
# changes every day (a file in CURSOR_DIR, deleted at the reset): Ficha keeps
# no MAC, no IP, no name.
WIFI_PORTAL=simulate
# Seconds a day per phone, 0 to 3600. 0 (or empty) = none.
FREE_CHARGE_SECONDS=120
FREE_INTERNET_SECONDS=120
# When the allowance starts over: midnight, local time (the only choice: a
# rolling 24 h window would have to link a phone across two daily salts).
FREE_RESET=midnight
# The numbers to call, first on the portal and on the station screen:
# "label number" pairs separated by ';', at most 6. Required with a portal.
# Portugal (the whole EU): 112.
EMERGENCY_NUMBERS='Emergency 112'
# Brazil:
# EMERGENCY_NUMBERS='Polícia 190; SAMU 192; Bombeiros 193'
# With the router (openNDS) instead of simulate, also:
# WIFI_PORTAL=opennds
# HOST=0.0.0.0
# MOCK_PAYMENT=false
# WIFI_SSID='Ficha SOS'
# WIFI_SECURITY=nopass

# --- stellar ---------------------------------------------------------------
# Switching networks is this one line (see the README checklist).
STELLAR_NETWORK=testnet
# Derived from STELLAR_NETWORK; set only to override. The other network's
# public Horizon is refused.
HORIZON_URL=
# The HOST's public key (the venue owner receives the money). Starts with G.
# NEVER put a secret key (starts with S) anywhere in this file.
# Empty is allowed only with MOCK_PAYMENT=true (the ledger is not watched).
HOST_PUBLIC_KEY=
# Empty = network default: testnet -> XLM, public -> USDC (Circle).
# XLM with empty issuer = native.
PAYMENT_ASSET_CODE=
PAYMENT_ASSET_ISSUER=
# At least 0.5.
HORIZON_POLL_SECONDS=2
# Cursor file is named per network and account inside this directory, which
# must exist and be writable.
CURSOR_DIR=.

# --- payment mode ------------------------------------------------------------
# direct: the payer pays the host with the SEP-0007 QR and the session's memo;
# unused time is logged for a refund by hand. custody (testnet only): the
# payer deposits into the FichaEscrow contract with the Ficha app, and the
# receipt carries the proof that refunds the time not charged here (README,
# section 7). Custody needs STATION_ID, HOST_PUBLIC_KEY, CHARGE_VERIFY=true
# and native XLM (empty PAYMENT_ASSET_CODE).
# Empty = direct.
PAYMENT_MODE=
# The FichaEscrow contract ID (C...), custody only. Testnet:
#   CBRNN2W726PIWP7DLLCAOW663I2TBSMR6N7J7S4CGGUIWIXK4HYI6KYC
ESCROW_CONTRACT=
# The Soroban RPC the station reads the contract through: read only, no key,
# no fee. Empty = https://soroban-testnet.stellar.org
RPC_URL=
# This station's terms on the contract (unit_secs and grace_secs), custody
# only: the refund unit in seconds (divides FICHA_MINUTES x 60, at most 256
# units in a session), and the time from the end of the paid time to the
# deadline: 1680 = 180 to plug in + 600 of pause + 900 for the payer to claim
# (at least 900 + PLUG_TIMEOUT_SECONDS).
REFUND_UNIT_SECONDS=30
ESCROW_GRACE_SECONDS=1680

# --- product ---------------------------------------------------------------
# Price of 1 ficha, in the payment asset, at most 7 decimals. The QR asks for
# exactly 1 ficha; the payer may edit the amount: fichas = floor(amount /
# FICHA_PRICE), and any remainder is logged as change_due for a manual refund.
FICHA_PRICE=1
FICHA_MINUTES=5
MAX_SESSION_MINUTES=60
COURTESY_SECONDS=60
COURTESY_COOLDOWN_SECONDS=300
# Current at or above this, while this station is verified to be charging
# the phone, makes a session "delivered"; below it the countdown pauses.
# At least 1.
MIN_CURRENT_MA=100
# How long the FINISHED screen (with the receipt QR) stays up, and the cut is
# confirmed. Empty = 20, or 60 in custody mode (the receipt carries the refund).
FINISHED_SECONDS=
SESSION_LOG=sessions.jsonl

# --- charge verification ---------------------------------------------------
# Paid time counts ONLY while this station is verifiably charging the phone.
# The meter reads the phone's own battery, which cannot tell this station's
# outlet from a socket at home, so the station checks with a probe: it opens
# the relay for PROBE_SECONDS. Current that stops (on usb_vbus: the phone
# vanishing) was this station's; current that keeps flowing comes from
# another charger. After a payment the countdown waits for current and a
# passing probe; it pauses when the current is gone for more than
# PAUSE_GRACE_SECONDS (those seconds are given back) or a probe fails.
# false = the countdown starts at payment whatever the phone does (the old
# behaviour, bench tests only; refused on the public network).
CHARGE_VERIFY=true
# phone = the ADB meter (the phone's battery current), checked by probes.
# outlet = a meter on the station's own output, whose current is always this
# station's: no probes, same pauses. There is no outlet meter yet: outlet
# works only with MOCK=true.
METER_SOURCE=phone
# Paid but not verified within this long: the relay opens, the session ends
# as not_plugged and all of its time goes to refund_hint.unused.
PLUG_TIMEOUT_SECONDS=180
# No current (below MIN_CURRENT_MA, or phone unreadable) for longer than
# this pauses the countdown. At least 5.
PAUSE_GRACE_SECONDS=20
# A pause this long ends the session as paused_too_long; the time left goes
# to refund_hint.unused.
PAUSE_TIMEOUT_SECONDS=600
# While counting, a probe every this many seconds (at least 10 x
# PROBE_SECONDS), and also when the current comes back after a dip.
PROBE_EVERY_SECONDS=300
# How long a probe keeps the relay open, 2 to 30 (its first reading may be
# from before the cut, so it is not judged). Not counted as paid time.
PROBE_SECONDS=3

# --- relay (LCUS V4.3, CH340, 9600 8N1) -------------------------------------
RELAY_PORT=COM3
RELAY_BAUD=9600
RELAY_CMD_CLOSE=A0 01 01 A2
RELAY_CMD_OPEN=A0 01 00 A1

# --- topology --------------------------------------------------------------
# Pick ONE block.

# MAINS (target): relay switches the PHASE feeding a 45 W USB-C PD charger.
# The USB cable carries no data here, so the phone is read over WiFi ADB.
TOPOLOGY=mains
ADB_TRANSPORT=tcp
# ip:port of the phone (adb tcpip 5555 once over USB, then use its WiFi IP)
ADB_SERIAL=

# USB_VBUS (fallback): USB extension with VBUS cut through the relay, on the
# laptop's USB 3.0 port. ADB rides the same cable and drops when power is cut,
# so ADB_TRANSPORT must be usb. A cut cable with the phone read over WiFi (a
# wall charger instead of the laptop) is TOPOLOGY=mains.
# TOPOLOGY=usb_vbus
# ADB_TRANSPORT=usb
# # optional: the phone's serial from `adb devices`
# ADB_SERIAL=

# --- meter (ADB) -----------------------------------------------------------
ADB_PATH=adb
# CHARGE_VERIFY=false only: seconds to wait for the phone to come back after
# the relay closes (usb_vbus) before counting anyway.
ADB_WAIT_TIMEOUT=20
# auto: learn the current's unit (uA/mA) and sign from the phone itself.
# Or a fixed multiplier from the raw current_now to mA, positive = charging,
# e.g. 0.001 (uA), -0.001 (uA, inverted), 1 (mA). Check with: python diag.py meter
METER_CURRENT_SCALE=auto
